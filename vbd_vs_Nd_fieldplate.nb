Cell["\<\
Trench MOSFET Drift Breakdown Voltage vs. Doping (Vbd vs. Nd)\
\>", "Title",
 FontFamily->"Helvetica",
 FontSize->24,
 FontColor->RGBColor[
  0.043, 0.239, 0.125],ExpressionUUID->"8e6c92f2-a116-3843-8241-5df5584b533c"],

Cell["\<\
2D Finite-Difference Poisson Model under Field-Plate Potentials (-10V, 0V, \
+10V)
Comparing Critical Electric Field (Ec = 3e5 V/cm) and Surface Ionization \
Integral Criteria
(Evaluate cells sequentially to execute simulations and render plots)\
\>", "Subtitle",
 FontFamily->"Helvetica",
 FontSize->13,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"d5d4d2b8-d9d9-4c46-8fc6-c71af3850ff2"],

