     RowBox[{"permittivity", " ", "[", 
      RowBox[{"F", "/", "cm"}], "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"epsS", " ", "=", " ", 
     RowBox[{"11.7", " ", "*", " ", "eps0"}]}], ";"}], "           ", 
   RowBox[{"(*", " ", 
    RowBox[{"Permittivity", " ", "of", " ", 
     RowBox[{"Silicon", " ", "[", 
      RowBox[{"F", "/", "cm"}], "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"epsOx", " ", "=", " ", 
     RowBox[{"3.9", " ", "*", " ", "eps0"}]}], ";"}], "           ", 
