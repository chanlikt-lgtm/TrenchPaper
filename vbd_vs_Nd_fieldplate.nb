   RowBox[{"(*", " ", 
    RowBox[{"Critical", " ", "field", " ", "in", " ", 
     RowBox[{"Silicon", " ", "[", 
      RowBox[{"V", "/", "cm"}], "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
