Cell["8. Interactive 2D Potential and Field Visualizer", "Section",
 FontFamily->"Helvetica",
 FontSize->17,
 FontColor->RGBColor[
  0.118, 0.494, 0.204],ExpressionUUID->"7f255ebc-f693-894b-a59d-087ae8b894aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Interactive", " ", "2", "D", " ", "Contour", " ", "and", " ", 
    "Streamline", " ", "Explorer"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"xCoords", " ", "=", " ", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "L", ",", " ", "dx"}], "]"}], " ", "/", " ", 
      "um"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yCoords", " ", "=", " ", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "a", ",", " ", "dy"}], "]"}], " ", "/", " ", 
      "um"}]}], ";"}], "\n", "\n", 
   RowBox[{"Manipulate", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ExTot", ",", " ", "EyTot", ",", " ", "phiTot", ",", " ", 
         "emagGrid"}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"phiTot", " ", "=", " ", 
         RowBox[{
          RowBox[{"ndSelect", " ", "*", " ", "phiCharge"}], " ", "+", " ", 
          RowBox[{"vfpSelect", " ", "*", " ", "phiFP"}], " ", "+", " ", 
          RowBox[{"vdSelect", " ", "*", " ", "phiDrain"}]}]}], ";", "\n", 
        "    ", 
        RowBox[{"ExTot", " ", "=", " ", 
         RowBox[{
          RowBox[{"ndSelect", " ", "*", " ", "ExCharge"}], " ", "+", " ", 
          RowBox[{"vfpSelect", " ", "*", " ", "ExFP"}], " ", "+", " ", 
          RowBox[{"vdSelect", " ", "*", " ", "ExDrain"}]}]}], ";", "\n", 
        "    ", 
        RowBox[{"EyTot", " ", "=", " ", 
         RowBox[{
          RowBox[{"ndSelect", " ", "*", " ", "EyCharge"}], " ", "+", " ", 
          RowBox[{"vfpSelect", " ", "*", " ", "EyFP"}], " ", "+", " ", 
          RowBox[{"vdSelect", " ", "*", " ", "EyDrain"}]}]}], ";", "\n", 
        "    ", 
        RowBox[{"emagGrid", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"ExTot", "^", "2"}], " ", "+", " ", 
           RowBox[{"EyTot", "^", "2"}]}], "]"}]}], ";", "\n", "    ", "\n", 
        "    ", 
        RowBox[{"ListContourPlot", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"Transpose", "[", "phiTot", "]"}], ",", "\n", "      ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"L", "/", "um"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"a", "/", "um"}]}], "}"}]}], "}"}]}], ",", "\n", 
          "      ", 
          RowBox[{"ColorFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"greenPinkCol", "[", "#", "]"}], "&"}], ")"}]}], ",", 
          "\n", "      ", 
          RowBox[{"ColorFunctionScaling", " ", "->", " ", "True"}], ",", "\n",
           "      ", 
          RowBox[{"Contours", " ", "->", " ", "20"}], ",", "\n", "      ", 
          RowBox[{"ContourLabels", " ", "->", " ", "Automatic"}], ",", "\n", 
          "      ", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "      ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Drift Position x [\[Mu]m]\>\"", ",", 
             " ", "\"\<Mesa Depth y [\[Mu]m]\>\""}], "}"}]}], ",", "\n", 
          "      ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Style", "[", "\n", "        ", 
            RowBox[{
             RowBox[{"StringForm", "[", 
              
              RowBox[{"\"\<Electrostatic Potential \[Phi](x, y) [V]  (Peak \
|E| = `` V/cm)\>\"", ",", " ", "\n", "          ", 
               RowBox[{"ScientificForm", "[", 
                RowBox[{
                 RowBox[{"Max", "[", "emagGrid", "]"}], ",", " ", "3"}], 
                "]"}]}], "]"}], ",", "\n", "        ", "12", ",", " ", "Bold",
              ",", " ", "colForest"}], "\n", "      ", "]"}]}], ",", "\n", 
          "      ", 
          RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", "\n", 
          "      ", 
          RowBox[{"ImageSize", " ", "->", " ", "600"}]}], "\n", "    ", 
         "]"}]}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ndSelect", ",", " ", "1.0*^15", ",", 
         " ", "\"\<Doping Concentration Nd [cm^-3]\>\""}], "}"}], ",", " ", 
       "1.0*^14", ",", " ", "1.0*^17", ",", " ", "1.0*^15", ",", " ", 
       RowBox[{"Appearance", " ", "->", " ", "\"\<Labeled\>\""}]}], "}"}], ",",
      "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "vfpSelect", ",", " ", "0.0", ",", 
         " ", "\"\<Field Plate Potential V_FP [V]\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10.0"}], ",", " ", "0.0", ",", " ", "10.0"}], "}"}], ",",
        " ", 
       RowBox[{"ControlType", " ", "->", " ", "SetterBar"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "vdSelect", ",", " ", "25.0", ",", 
         " ", "\"\<Applied Drain Voltage V_drain [V]\>\""}], "}"}], ",", " ", 
       "0.0", ",", " ", "50.0", ",", " ", "1.0", ",", " ", 
       RowBox[{"Appearance", " ", "->", " ", "\"\<Labeled\>\""}]}], "}"}], ",",
      "\n", "  ", 
     RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "\n", 
    "]"}]}]}]], "Input",ExpressionUUID->"0a02199b-9eb4-1949-adff-\
