     RowBox[{"thickness", ":", " ", 
      RowBox[{"0.5", " ", 
       RowBox[{"um", " ", "[", "cm", "]"}]}]}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Robin", " ", "Oxide", " ", "Boundary", " ", 
