     RowBox[{"charge", " ", "[", "C", "]"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"eps0", " ", "=", " ", "8.8541878128*^-14"}], ";"}], "     ", 
   RowBox[{"(*", " ", 
