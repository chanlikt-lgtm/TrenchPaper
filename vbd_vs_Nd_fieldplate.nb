  0.118, 0.494, 0.204],ExpressionUUID->"5e0d88a9-cc25-8b4f-a489-632c8915490e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Physical", " ", "and", " ", "Material", " ", "Constants"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"q", " ", "=", " ", "1.602176634*^-19"}], ";"}], "         ", 
