Cell["3. 2D Finite Difference Poisson Basis Assembly", "Section",
 FontFamily->"Helvetica",
 FontSize->17,
 FontColor->RGBColor[
  0.118, 0.494, 0.204],ExpressionUUID->"1945df26-a577-fc4e-840a-146937a41bd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Mesh", " ", 
     RowBox[{"Discretization", ":", " ", 
      RowBox[{"Nx", " ", "along", " ", "x", " ", 
       RowBox[{"(", "drift", ")"}]}]}]}], ",", " ", 
    RowBox[{"Ny", " ", "along", " ", "y", " ", 
     RowBox[{"(", 
      RowBox[{"mesa", " ", "thickness"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"nx", " ", "=", " ", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ny", " ", "=", " ", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dx", " ", "=", " ", 
     RowBox[{"L", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"nx", " ", "-", " ", "1"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dy", " ", "=", " ", 
     RowBox[{"a", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"ny", " ", "-", " ", "1"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Ntotal", " ", "=", " ", 
     RowBox[{"nx", " ", "*", " ", "ny"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kIdx", "[", 
      RowBox[{"i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", " ", "-", " ", "1"}], ")"}], " ", "*", " ", "ny"}], " ", 
      "+", " ", "j"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Assembling 2D Sparse Poisson Matrix on \>\"", ",", " ", 
      "nx", ",", " ", "\"\< x \>\"", ",", " ", "ny", ",", 
      " ", "\"\< grid (\>\"", ",", " ", "Ntotal", ",", 
      " ", "\"\< nodes)...\>\""}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"rules", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bCharge", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.0", ",", " ", "Ntotal"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bDrain", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.0", ",", " ", "Ntotal"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bFP", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.0", ",", " ", "Ntotal"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"k", " ", "=", " ", 
          RowBox[{"kIdx", "[", 
           RowBox[{"i", ",", " ", "j"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Which", "[", "\n", "      ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Source", " ", 
             RowBox[{"contact", ":", " ", "x"}]}], " ", "=", " ", 
            RowBox[{
             RowBox[{"0", " ", "->", " ", "phi"}], " ", "=", " ", "0"}]}], 
           " ", "*)"}], "\n", "      ", 
          RowBox[{
           RowBox[{"i", " ", "==", " ", "1"}], ",", "\n", "      ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"rules", ",", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"k", ",", " ", "k"}], "}"}], " ", "->", " ", "1.0"}]}],
             "]"}], ",", "\n", "      ", "\n", "      ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"Drain", " ", 
              RowBox[{"contact", ":", " ", "x"}]}], " ", "=", " ", 
             RowBox[{
              RowBox[{"L", " ", "->", " ", "phi"}], " ", "=", " ", 
              "Vdrain"}]}], " ", "*)"}], "\n", "      ", 
           RowBox[{"i", " ", "==", " ", "nx"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", "k"}], "}"}], " ", "->", " ", 
               "1.0"}]}], "]"}], ";", "\n", "      ", 
            RowBox[{
             RowBox[{"bDrain", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", "1.0"}]}], ",", 
           "\n", "      ", "\n", "      ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"Trench", " ", "oxide", " ", 
              RowBox[{"interface", ":", " ", "y"}]}], " ", "=", " ", 
             RowBox[{
              RowBox[{"a", " ", "->", " ", 
               RowBox[{"phi", " ", "+", " ", 
                RowBox[{"b", " ", "*", " ", 
                 RowBox[{"dphi", "/", "dy"}]}]}]}], " ", "=", " ", "V_FP"}]}],
             " ", "*)"}], "\n", "      ", 
           RowBox[{"j", " ", "==", " ", "ny"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", "k"}], "}"}], " ", "->", " ", 
               RowBox[{"1.0", " ", "+", " ", 
                RowBox[{"bRobin", "/", "dy"}]}]}]}], "]"}], ";", "\n", 
            "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", 
                 RowBox[{"kIdx", "[", 
                  RowBox[{"i", ",", " ", 
                   RowBox[{"j", " ", "-", " ", "1"}]}], "]"}]}], "}"}], " ", "->",
                " ", 
               RowBox[{
                RowBox[{"-", "bRobin"}], "/", "dy"}]}]}], "]"}], ";", "\n", 
            "      ", 
            RowBox[{
             RowBox[{"bFP", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", "1.0"}]}], ",", 
           "\n", "      ", "\n", "      ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"Centerline", " ", 
              RowBox[{"symmetry", ":", " ", "y"}]}], " ", "=", " ", 
             RowBox[{
              RowBox[{"0", " ", "->", " ", 
               RowBox[{"dphi", "/", "dy"}]}], " ", "=", " ", "0"}]}], " ", 
            "*)"}], "\n", "      ", 
           RowBox[{"j", " ", "==", " ", "1"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", "k"}], "}"}], " ", "->", " ", 
               "1.0"}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", 
                 RowBox[{"kIdx", "[", 
                  RowBox[{"i", ",", " ", "2"}], "]"}]}], "}"}], " ", "->", 
               " ", 
               RowBox[{"-", "1.0"}]}]}], "]"}]}], ",", "\n", "      ", "\n", 
           "      ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"Interior", " ", "Poisson", " ", 
              RowBox[{"Equation", ":", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"d", "^", "2"}], 
                 RowBox[{"phi", "/", 
                  RowBox[{"dx", "^", "2"}]}]}], " ", "+", " ", 
                RowBox[{
                 RowBox[{"d", "^", "2"}], 
                 RowBox[{"phi", "/", 
                  RowBox[{"dy", "^", "2"}]}]}]}]}]}], " ", "=", " ", 
             RowBox[{
              RowBox[{"-", "rho"}], "/", "epsS"}]}], " ", "*)"}], "\n", 
           "      ", "True", ",", "\n", "      ", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", "k"}], "}"}], " ", "->", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "2.0"}], "/", 
                 RowBox[{"dx", "^", "2"}]}], " ", "-", " ", 
                RowBox[{"2.0", "/", 
                 RowBox[{"dy", "^", "2"}]}]}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", 
                 RowBox[{"kIdx", "[", 
                  RowBox[{
                   RowBox[{"i", " ", "-", " ", "1"}], ",", " ", "j"}], 
                  "]"}]}], "}"}], " ", "->", " ", 
               RowBox[{"1.0", "/", 
                RowBox[{"dx", "^", "2"}]}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", 
                 RowBox[{"kIdx", "[", 
                  RowBox[{
                   RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], 
                  "]"}]}], "}"}], " ", "->", " ", 
               RowBox[{"1.0", "/", 
                RowBox[{"dx", "^", "2"}]}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", 
                 RowBox[{"kIdx", "[", 
                  RowBox[{"i", ",", " ", 
                   RowBox[{"j", " ", "-", " ", "1"}]}], "]"}]}], "}"}], " ", "->",
                " ", 
               RowBox[{"1.0", "/", 
                RowBox[{"dy", "^", "2"}]}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"rules", ",", " ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", 
                 RowBox[{"kIdx", "[", 
                  RowBox[{"i", ",", " ", 
                   RowBox[{"j", " ", "+", " ", "1"}]}], "]"}]}], "}"}], " ", "->",
                " ", 
               RowBox[{"1.0", "/", 
                RowBox[{"dy", "^", "2"}]}]}]}], "]"}], ";", "\n", "      ", 
            RowBox[{
             RowBox[{"bCharge", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", "=", " ", 
             RowBox[{
              RowBox[{"-", "q"}], " ", "/", " ", "epsS"}]}]}]}], "\n", "    ",
           "]"}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "1", ",", " ", "ny"}], "}"}]}], "\n", "  ", 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "nx"}], "}"}]}], "\n", "]"}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"spA", " ", "=", " ", 
     RowBox[{"SparseArray", "[", 
      RowBox[{"rules", ",", " ", 
       RowBox[{"{", 
        RowBox[{"Ntotal", ",", " ", "Ntotal"}], "}"}]}], "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Solving linear systems for basis potentials (Charge, \
Drain, Field-Plate)...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"phiCharge", " ", "=", " ", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"LinearSolve", "[", 
        RowBox[{"spA", ",", " ", "bCharge"}], "]"}], ",", " ", "ny"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"phiDrain", " ", "=", " ", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"LinearSolve", "[", 
        RowBox[{"spA", ",", " ", "bDrain"}], "]"}], ",", " ", "ny"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"phiFP", " ", "=", " ", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"LinearSolve", "[", 
        RowBox[{"spA", ",", " ", "bFP"}], "]"}], ",", " ", "ny"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Basis potentials solved successfully!\>\"", "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"c6b69d57-7a78-9743-85a1-\
1ee808c0ed9d"],

Cell["4. Electric Field Gradients and Breakdown Criteria", "Section",
 FontFamily->"Helvetica",
 FontSize->17,
 FontColor->RGBColor[
  0.118, 0.494, 0.204],ExpressionUUID->"debb227e-29f3-144c-90b0-1e83c18ef50e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Finite", " ", "Difference", " ", "Spatial", " ", "Gradient", " ", 
    "Functions"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gradX", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Which", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"i", " ", "==", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "j"}], "]"}], "]"}], " ", "-", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "j"}], "]"}], "]"}]}], ")"}], " ", "/", 
          " ", "dx"}], ",", "\n", "    ", 
         RowBox[{"i", " ", "==", " ", "nx"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"nx", ",", " ", "j"}], "]"}], "]"}], " ", "-", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"nx", " ", "-", " ", "1"}], ",", " ", "j"}], "]"}], 
             "]"}]}], ")"}], " ", "/", " ", "dx"}], ",", "\n", "    ", "True",
          ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "]"}], 
             "]"}], " ", "-", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", " ", "-", " ", "1"}], ",", " ", "j"}], "]"}], 
             "]"}]}], ")"}], " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"2.0", " ", "*", " ", "dx"}], ")"}]}]}], "\n", "  ", "]"}],
        ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "nx"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", "ny"}], "}"}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gradY", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Which", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"j", " ", "==", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "1"}], "]"}], "]"}]}], ")"}], " ", "/", 
          " ", "dy"}], ",", "\n", "    ", 
         RowBox[{"j", " ", "==", " ", "ny"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "ny"}], "]"}], "]"}], " ", "-", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", 
               RowBox[{"ny", " ", "-", " ", "1"}]}], "]"}], "]"}]}], ")"}], 
          " ", "/", " ", "dy"}], ",", "\n", "    ", "True", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", 
               RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", "-", 
            " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", 
               RowBox[{"j", " ", "-", " ", "1"}]}], "]"}], "]"}]}], ")"}], 
          " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"2.0", " ", "*", " ", "dy"}], ")"}]}]}], "\n", "  ", "]"}],
        ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "nx"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", "ny"}], "}"}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Electric", " ", "Field", " ", "Basis", " ", 
      RowBox[{"Components", ":", " ", "E"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "grad"}], 
      RowBox[{"(", "phi", ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ExCharge", " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"gradX", "[", "phiCharge", "]"}]}]}], ";", " ", 
    RowBox[{"EyCharge", " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"gradY", "[", "phiCharge", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ExDrain", "  ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"gradX", "[", "phiDrain", "]"}]}]}], ";", "  ", 
    RowBox[{"EyDrain", "  ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"gradY", "[", "phiDrain", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ExFP", "     ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"gradX", "[", "phiFP", "]"}]}]}], ";", "     ", 
    RowBox[{"EyFP", "     ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"gradY", "[", "phiFP", "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "munfl"}], "]"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Suppress", " ", "machine", " ", "underflow", " ", "messages", " ", 
      "for", " ", "small", " ", "E"}], "-", "fields"}], " ", "*)"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Breakdown", " ", "Voltage", " ", "Calculator", " ", "for", " ", "given", 
     " ", "Nd", " ", "and", " ", "V_FP"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"calcVbd", "[", 
      RowBox[{
       RowBox[{"ndVal_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"vfpVal_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Ex0", ",", " ", "Ey0", ",", " ", "maxE", ",", " ", "ionInt", ",", 
         " ", 
         RowBox[{"vMin", " ", "=", " ", "0.0"}], ",", " ", 
         RowBox[{"vMax", " ", "=", " ", "3000.0"}], ",", " ", 
         RowBox[{"vbdEc", " ", "=", " ", "0.0"}], ",", " ", 
         RowBox[{"vbdIon", " ", "=", " ", "0.0"}], ",", " ", "sol"}], "}"}], ",",
        "\n", "  ", "\n", "  ", 
       RowBox[{
        RowBox[{"Ex0", " ", "=", " ", 
         RowBox[{
          RowBox[{"ndVal", " ", "*", " ", "ExCharge"}], " ", "+", " ", 
          RowBox[{"vfpVal", " ", "*", " ", "ExFP"}]}]}], ";", "\n", "  ", 
        RowBox[{"Ey0", " ", "=", " ", 
         RowBox[{
          RowBox[{"ndVal", " ", "*", " ", "EyCharge"}], " ", "+", " ", 
          RowBox[{"vfpVal", " ", "*", " ", "EyFP"}]}]}], ";", "\n", "  ", 
        "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"1.", " ", "Critical", " ", "Electric", " ", "Field", " ", 
           RowBox[{"Criterion", ":", " ", 
            RowBox[{"max", " ", "|", "E", "|"}]}]}], " ", "=", " ", "Ec"}], 
         " ", "*)"}], "\n", "  ", 
        RowBox[{
         RowBox[{"maxE", "[", 
          RowBox[{"vd_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Ex0", " ", "+", " ", 
                 RowBox[{"vd", " ", "*", " ", "ExDrain"}]}], ")"}], "^", 
               "2"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Ey0", " ", "+", " ", 
                 RowBox[{"vd", " ", "*", " ", "EyDrain"}]}], ")"}], "^", 
               "2"}]}], "]"}], "]"}], "]"}], " ", "-", " ", "EcSi"}]}], ";", 
        "\n", "  ", "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "2.", " ", "Surface", " ", "Ionization", " ", "Integral", " ", 
          "Criterion", " ", "along", " ", "oxide", " ", "interface", " ", 
          RowBox[{"(", 
           RowBox[{"j", " ", "=", " ", "ny"}], ")"}]}], " ", "*)"}], "\n", 
        "  ", 
        RowBox[{
         RowBox[{"ionInt", "[", 
          RowBox[{"vd_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"emagPath", ",", " ", "alpha", ",", " ", "trapz"}], "}"}],
            ",", "\n", "    ", 
           RowBox[{
            RowBox[{"emagPath", " ", "=", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Ex0", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", " ", "ny"}], "]"}], "]"}], " ", "+", 
                  " ", 
                  RowBox[{"vd", " ", "*", " ", 
                   RowBox[{"ExDrain", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "ny"}], "]"}], "]"}]}]}], ")"}], 
                "^", "2"}], " ", "+", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Ey0", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", " ", "ny"}], "]"}], "]"}], " ", "+", 
                  " ", 
                  RowBox[{"vd", " ", "*", " ", 
                   RowBox[{"EyDrain", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "ny"}], "]"}], "]"}]}]}], ")"}], 
                "^", "2"}]}], "]"}]}], ";", "\n", "    ", 
            RowBox[{"alpha", " ", "=", " ", 
             RowBox[{"aSi", " ", "*", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "bSi"}], " ", "/", " ", 
                RowBox[{"Ramp", "[", 
                 RowBox[{"emagPath", " ", "+", " ", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "10"}]}]}], "]"}]}], "]"}]}]}], ";", "\n", 
            "    ", 
            RowBox[{"trapz", " ", "=", " ", 
             RowBox[{"dx", " ", "*", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Total", "[", "alpha", "]"}], " ", "-", " ", 
                RowBox[{"0.5", " ", "*", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"First", "[", "alpha", "]"}], " ", "+", " ", 
                   RowBox[{"Last", "[", "alpha", "]"}]}], ")"}]}]}], 
               ")"}]}]}], ";", "\n", "    ", 
            RowBox[{"trapz", " ", "-", " ", "1.0"}]}]}], "\n", "  ", "]"}]}], 
        ";", "\n", "  ", "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Solve", " ", "for", " ", "Vbd", " ", 
          RowBox[{"(", 
           RowBox[{"Critical", " ", "Field"}], ")"}]}], " ", "*)"}], "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"maxE", "[", "vMin", "]"}], " ", "<=", " ", "0.0"}], " ", 
           "&&", " ", 
           RowBox[{
            RowBox[{"maxE", "[", "vMax", "]"}], " ", ">=", " ", "0.0"}]}], ",",
           "\n", "    ", 
          RowBox[{
           RowBox[{"sol", " ", "=", " ", 
            RowBox[{"Quiet", "[", 
             RowBox[{"FindRoot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"maxE", "[", "v", "]"}], " ", "==", " ", "0.0"}], ",",
                " ", 
               RowBox[{"{", 
                RowBox[{"v", ",", " ", "vMin", ",", " ", "vMax"}], "}"}], ",",
                " ", 
               RowBox[{"Method", " ", "->", " ", "\"\<Brent\>\""}]}], "]"}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MatchQ", "[", 
              RowBox[{"sol", ",", " ", 
               RowBox[{"{", "_Rule", "}"}]}], "]"}], ",", " ", 
             RowBox[{"vbdEc", " ", "=", " ", 
              RowBox[{"v", " ", "/.", " ", "sol"}]}]}], "]"}], ";"}]}], "\n", 
         "  ", "]"}], ";", "\n", "  ", "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Solve", " ", "for", " ", "Vbd", " ", 
          RowBox[{"(", 
           RowBox[{"Ionization", " ", "Integral"}], ")"}]}], " ", "*)"}], 
        "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ionInt", "[", "vMin", "]"}], " ", "<=", " ", "0.0"}], 
           " ", "&&", " ", 
           RowBox[{
            RowBox[{"ionInt", "[", "vMax", "]"}], " ", ">=", " ", "0.0"}]}], ",",
           "\n", "    ", 
          RowBox[{
           RowBox[{"sol", " ", "=", " ", 
            RowBox[{"Quiet", "[", 
             RowBox[{"FindRoot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ionInt", "[", "v", "]"}], " ", "==", " ", "0.0"}], ",",
                " ", 
               RowBox[{"{", 
                RowBox[{"v", ",", " ", "vMin", ",", " ", "vMax"}], "}"}], ",",
                " ", 
               RowBox[{"Method", " ", "->", " ", "\"\<Brent\>\""}]}], "]"}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MatchQ", "[", 
              RowBox[{"sol", ",", " ", 
               RowBox[{"{", "_Rule", "}"}]}], "]"}], ",", " ", 
             RowBox[{"vbdIon", " ", "=", " ", 
              RowBox[{"v", " ", "/.", " ", "sol"}]}]}], "]"}], ";"}]}], "\n", 
         "  ", "]"}], ";", "\n", "  ", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"vbdEc", ",", " ", "vbdIon"}], "}"}]}]}], "\n", "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"2bf79b11-9ab9-b245-8d9b-\
67f71c409949"],

Cell["5. Simulation Sweep Across Doping Concentration Nd", "Section",
 FontFamily->"Helvetica",
 FontSize->17,
 FontColor->RGBColor[
  0.118, 0.494, 0.204],ExpressionUUID->"ff861618-87ee-ba4c-93f5-16b65417b39a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Log", "-", 
    RowBox[{"spaced", " ", "doping", " ", "range", " ", "from", " ", 
     RowBox[{"10", "^", "14"}], " ", "to", " ", 
     RowBox[{"10", "^", "17"}], " ", 
     RowBox[{"cm", "^", 
      RowBox[{"-", "3"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ndVals", " ", "=", " ", 
     RowBox[{"10", "^", 
      RowBox[{"Range", "[", 
       RowBox[{"14.0", ",", " ", "17.0", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"17.0", " ", "-", " ", "14.0"}], ")"}], "/", "19"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vfpCases", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.0", ",", " ", 
       RowBox[{"-", "10.0"}], ",", " ", "10.0"}], "}"}]}], ";"}], "\n", "\n", 
   
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Executing Breakdown Voltage Sweep across Nd and \
V_FP...\>\"", "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"resultsData", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Evaluating case V_FP = \>\"", ",", " ", "vfp", ",", 
          " ", "\"\< V...\>\""}], "]"}], ";", "\n", "  ", 
        RowBox[{"Table", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"vbd", " ", "=", " ", 
            RowBox[{"calcVbd", "[", 
             RowBox[{"nd", ",", " ", "vfp"}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"nd", ",", " ", 
             RowBox[{"vbd", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"vbd", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"nd", ",", " ", "ndVals"}], "}"}]}], "\n", "  ", "]"}]}], ",",
        "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"vfp", ",", " ", "vfpCases"}], "}"}]}], "\n", "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Sweep completed! Extracted data for \>\"", ",", " ", 
      RowBox[{"Length", "[", "ndVals", "]"}], ",", 
      " ", "\"\< doping points across \>\"", ",", " ", 
      RowBox[{"Length", "[", "vfpCases", "]"}], ",", 
      " ", "\"\< field plate potentials.\>\""}], "]"}], ";"}]}]}]], "Input",Ex\
pressionUUID->"58adac65-48de-354a-9685-7a3914ff2895"],

Cell["6. Publication-Quality Plots of Vbd vs. Nd", "Section",
