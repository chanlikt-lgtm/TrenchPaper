Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Format", " ", "Data", " ", "Series", " ", "for", " ", 
    "ListLogLinearPlot"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ptsEc0", "   ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pt", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"pt", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
